// ステージ進行のルールです。
// 直線コース時代の到達距離やチェックポイント許容量は、工場ステージでは
// 使わなくなったため削除しました。落下復帰の閾値だけが残ります。
WIRE_TUNING_GROUP(WireStageTuning, Stage)
// この高さより下へ落ちたら、直近の安全地点へ戻します。
WIRE_TUNING_FLOAT_RANGE(FallResetY, "wire.stage.fall_reset_y", -20.0f, -500.0f, 0.0f)
