WIRE_TUNING_GROUP(WireCameraTuning, Camera)
WIRE_TUNING_FLOAT(BaseFov, "wire.camera.base_fov", 1.0f)
// 速度に応じて広がる視野の上限です。差が小さいと速度が画面に出ません。
WIRE_TUNING_FLOAT(MaxWireFov, "wire.camera.max_wire_fov", 1.30f)
WIRE_TUNING_FLOAT(FovBoostStartSpeed, "wire.camera.fov_boost_start_speed", 16.0f)
WIRE_TUNING_FLOAT(FovBoostFullSpeed, "wire.camera.fov_boost_full_speed", 42.0f)
WIRE_TUNING_FLOAT(FovWireActiveBias, "wire.camera.fov_wire_active_bias", 0.035f)
WIRE_TUNING_FLOAT(FovFollowLerp, "wire.camera.fov_follow_lerp", 0.12f)
WIRE_TUNING_FLOAT(AimFov, "wire.camera.aim_fov", 0.82f)
WIRE_TUNING_FLOAT(NearClip, "wire.camera.near_clip", 0.1f)
WIRE_TUNING_FLOAT(FarClip, "wire.camera.far_clip", 1000.0f)
WIRE_TUNING_FLOAT(InitialHeight, "wire.camera.initial_height", 6.0f)
WIRE_TUNING_FLOAT(InitialDistance, "wire.camera.initial_distance", -9.2f)
WIRE_TUNING_FLOAT(InitialPitch, "wire.camera.initial_pitch", 0.38f)   // 開始時は水平寄り。見下ろすと工場の全体像が見えないため
WIRE_TUNING_FLOAT(NormalMinPitchDegrees, "wire.camera.normal_min_pitch_degrees", -88.0f)
WIRE_TUNING_FLOAT(NormalMaxPitchDegrees, "wire.camera.normal_max_pitch_degrees", 88.0f)
WIRE_TUNING_FLOAT(AimMinPitchDegrees, "wire.camera.aim_min_pitch_degrees", -88.0f)
WIRE_TUNING_FLOAT(AimMaxPitchDegrees, "wire.camera.aim_max_pitch_degrees", 88.0f)
WIRE_TUNING_FLOAT(NormalPitchMouseScale, "wire.camera.normal_pitch_mouse_scale", 0.62f)
WIRE_TUNING_FLOAT(AimPitchMouseScale, "wire.camera.aim_pitch_mouse_scale", 0.85f)
// 平常時は近めに寄せてキャラを大きく見せ、速度が乗ったぶんだけ引きます(SpeedDistanceBoost)。
WIRE_TUNING_FLOAT(NormalCameraDistance, "wire.camera.normal_distance", 9.4f)
WIRE_TUNING_FLOAT(DistanceFollowLerp, "wire.camera.distance_follow_lerp", 0.12f)
WIRE_TUNING_FLOAT(NormalFollowLerp, "wire.camera.normal_follow_lerp", 0.22f)
WIRE_TUNING_FLOAT(WireFollowLerp, "wire.camera.wire_follow_lerp", 0.52f)
WIRE_TUNING_FLOAT(AimFollowLerp, "wire.camera.aim_follow_lerp", 0.34f)
WIRE_TUNING_FLOAT(NormalTargetHeight, "wire.camera.normal_target_height", 1.45f)
WIRE_TUNING_FLOAT(NormalMinCameraHeight, "wire.camera.normal_min_camera_height", 0.85f)
WIRE_TUNING_FLOAT(NormalLookAhead, "wire.camera.normal_look_ahead", 1.8f)
WIRE_TUNING_FLOAT(AimCameraHeight, "wire.camera.aim_height", 1.65f)
WIRE_TUNING_FLOAT(AimBackDistance, "wire.camera.aim_back_distance", 0.85f)
WIRE_TUNING_FLOAT(AimShoulderOffset, "wire.camera.aim_shoulder_offset", 1.18f)
WIRE_TUNING_FLOAT(AimFocusDistance, "wire.camera.aim_focus_distance", 24.0f)

// --- 疾走感まわり ---
// 速度が上がるほどカメラを後ろへ引き、視野を広げ、追従を締めます。
// 引く量と広げる量が揃って初めて「速い」と感じられるため、3つは同じspeedRatioで駆動します。
WIRE_TUNING_FLOAT(SpeedDistanceBoost, "wire.camera.speed_distance_boost", 4.6f)
WIRE_TUNING_FLOAT(SpeedFollowLerpBoost, "wire.camera.speed_follow_lerp_boost", 0.20f)
// 横方向の速度でカメラを傾けます。ワイヤーで振られるときの体感差が大きい要素です。
WIRE_TUNING_FLOAT(RollPerLateralSpeed, "wire.camera.roll_per_lateral_speed", 0.0075f)
WIRE_TUNING_FLOAT(MaxRoll, "wire.camera.max_roll", 0.20f)
WIRE_TUNING_FLOAT(RollLerp, "wire.camera.roll_lerp", 0.10f)

// --- 衝撃演出 ---
// トラウマ値(0-1)を二乗して揺れ幅にします。小さい衝撃が過剰に暴れないようにするためです。
WIRE_TUNING_FLOAT(ShakeDecay, "wire.camera.shake_decay", 2.8f)
WIRE_TUNING_FLOAT(ShakeMaxOffset, "wire.camera.shake_max_offset", 0.80f)
WIRE_TUNING_FLOAT(ShakeMaxAngle, "wire.camera.shake_max_angle", 0.05f)
WIRE_TUNING_FLOAT(ShakeFrequency, "wire.camera.shake_frequency", 24.0f)
// 攻撃時にカメラを一瞬押し戻すバネです。減衰と戻る強さで手応えが決まります。
WIRE_TUNING_FLOAT(PunchSpring, "wire.camera.punch_spring", 150.0f)
WIRE_TUNING_FLOAT(PunchDamping, "wire.camera.punch_damping", 15.0f)
WIRE_TUNING_FLOAT(FovKickDecay, "wire.camera.fov_kick_decay", 6.0f)
WIRE_TUNING_FLOAT(FovKickMax, "wire.camera.fov_kick_max", 0.22f)

// 各アクションが与える衝撃量です。0にすればその演出だけを切れます。
WIRE_TUNING_FLOAT(LandingShake, "wire.camera.landing_shake", 0.26f)
WIRE_TUNING_FLOAT(LandingSpeedForFullShake, "wire.camera.landing_speed_for_full_shake", 34.0f)
WIRE_TUNING_FLOAT(BlinkShake, "wire.camera.blink_shake", 0.16f)
WIRE_TUNING_FLOAT(BlinkFovKick, "wire.camera.blink_fov_kick", 0.10f)
WIRE_TUNING_FLOAT(WireAttachShake, "wire.camera.wire_attach_shake", 0.18f)
WIRE_TUNING_FLOAT(WireAttachFovKick, "wire.camera.wire_attach_fov_kick", 0.06f)
WIRE_TUNING_FLOAT(WallKickShake, "wire.camera.wall_kick_shake", 0.20f)
WIRE_TUNING_FLOAT(WallKickFovKick, "wire.camera.wall_kick_fov_kick", 0.09f)
WIRE_TUNING_FLOAT(DamageShake, "wire.camera.damage_shake", 0.55f)

// --- 速度線 ---
// カメラの脇を後方へ流れる線を出し、速度そのものを画面で読めるようにします。
WIRE_TUNING_FLOAT(SpeedLineStartSpeed, "wire.camera.speed_line_start_speed", 20.0f)
WIRE_TUNING_FLOAT(SpeedLineFullSpeed, "wire.camera.speed_line_full_speed", 46.0f)
WIRE_TUNING_INT(SpeedLineMaxPerFrame, "wire.camera.speed_line_max_per_frame", 4)
WIRE_TUNING_FLOAT(SpeedLineSpread, "wire.camera.speed_line_spread", 3.4f)
WIRE_TUNING_FLOAT(SpeedLineForwardOffset, "wire.camera.speed_line_forward_offset", 7.0f)
WIRE_TUNING_FLOAT(SpeedLineSpeed, "wire.camera.speed_line_speed", 34.0f)
WIRE_TUNING_GROUP_END()

// 50mごとの踊り場を巡回する敵と、被弾するプレイヤー側の値です。
WIRE_TUNING_GROUP(WireEnemyTuning, Enemy)
WIRE_TUNING_INT(CountPerRooftop, "wire.enemy.count_per_rooftop", 2)
WIRE_TUNING_FLOAT(PatrolSpeed, "wire.enemy.patrol_speed", 3.2f)
