// Wire Action の調整値の一覧です。調整値を足す・消すときは、このファイルだけを編集します。
//
//   WIRE_TUNING_GROUP(構造体名, WireGameplayTuning のメンバー名) 〜 WIRE_TUNING_GROUP_END()   まとまり1つ分
//   WIRE_TUNING_FLOAT(名前, "設定ファイルのキー", 既定値)                     範囲は -10倍〜+10倍
//   WIRE_TUNING_FLOAT_RANGE(名前, "設定ファイルのキー", 既定値, 最小, 最大)   範囲を自分で決める
//   WIRE_TUNING_INT(名前, "設定ファイルのキー", 既定値)                       範囲は 0〜10倍(最低100)
//   WIRE_TUNING_INT_RANGE(名前, "設定ファイルのキー", 既定値, 最小, 最大)
//
// ここに1行書くと、構造体のメンバー(GetWireGameplayTuning().まとまり.名前)、
// assets/config/wire-gameplay.cfg からの上書き、設定ファイルの書き間違い検出(FindUnknownWireTuningKeys)がそろいます。
// 新しいまとまりを足すときだけ、wireGameplayTuning.h の WireGameplayTuning にメンバーを1行足してください。
// 値同士の関係の検証(下限や上下関係)は wireGameplayTuning.cpp に残っています。
// このファイルは wireGameplayTuning.h と wireGameplayTuning.cpp から、マクロの定義を変えて読み込まれます。

WIRE_TUNING_GROUP(WireMovementTuning, Movement)
WIRE_TUNING_FLOAT(WorldBoundsX, "wire.movement.world_bounds_x", 80.0f)
WIRE_TUNING_FLOAT(WorldBoundsZ, "wire.movement.world_bounds_z", 80.0f)
WIRE_TUNING_FLOAT(PlayerModelYawOffset, "wire.movement.player_model_yaw_offset", 3.14159265f)
WIRE_TUNING_FLOAT(Gravity, "wire.movement.gravity", -42.0f)
WIRE_TUNING_FLOAT(GroundAcceleration, "wire.movement.ground_acceleration", 66.0f)
WIRE_TUNING_FLOAT(AirAcceleration, "wire.movement.air_acceleration", 24.0f)
WIRE_TUNING_FLOAT(GroundDamping, "wire.movement.ground_damping", 6.4f)
WIRE_TUNING_FLOAT(AirDamping, "wire.movement.air_damping", 0.08f)
WIRE_TUNING_FLOAT(JumpVelocity, "wire.movement.jump_velocity", 14.5f)
WIRE_TUNING_FLOAT(AimMoveScale, "wire.movement.aim_move_scale", 0.34f)
WIRE_TUNING_FLOAT(AimHorizontalDamping, "wire.movement.aim_horizontal_damping", 24.0f)
WIRE_TUNING_FLOAT(AimGravityScale, "wire.movement.aim_gravity_scale", 0.42f)
WIRE_TUNING_FLOAT_RANGE(AimFallSpeedLimit, "wire.movement.aim_fall_speed_limit", 0.0f, -100.0f, 0.0f) // 構え中の最低下降速度。0なら落下せず空中で静止する
WIRE_TUNING_FLOAT(BlinkStepDistance, "wire.movement.blink_step_distance", 0.0f)
WIRE_TUNING_FLOAT(BlinkSpeed, "wire.movement.blink_speed", 38.0f)
// ブリンクは現在速度を新しい方向へ引き継ぎます(勢い保存)。これはその上限です。
WIRE_TUNING_FLOAT(BlinkCarryMaxSpeed, "wire.movement.blink_carry_max_speed", 55.0f)
// 空中で連続使用できる回数。着地またはワイヤー接続で回復します。
// UIゲージのピップ表示と一致させるため、上限をkMaxAirBlinkChargesで制限します。
WIRE_TUNING_INT_RANGE(AirBlinkCharges, "wire.movement.air_blink_charges", 1, 0, kMaxAirBlinkCharges)
WIRE_TUNING_FLOAT(BlinkDuration, "wire.movement.blink_duration", 0.14f)
WIRE_TUNING_FLOAT(BlinkCooldown, "wire.movement.blink_cooldown", 0.34f)
WIRE_TUNING_FLOAT(BlinkTurnLerp, "wire.movement.blink_turn_lerp", 0.88f)
WIRE_TUNING_FLOAT(BlinkScaleXZ, "wire.movement.blink_scale_xz", 1.35f)
WIRE_TUNING_FLOAT(BlinkScaleY, "wire.movement.blink_scale_y", 0.72f)
WIRE_TUNING_FLOAT(BlinkParticleHeight, "wire.movement.blink_particle_height", 0.95f)
WIRE_TUNING_INT(BlinkStartParticleCount, "wire.movement.blink_start_particles", 58)
WIRE_TUNING_INT(BlinkEndParticleCount, "wire.movement.blink_end_particles", 78)
WIRE_TUNING_INT(BlinkTrailParticleCount, "wire.movement.blink_trail_particles", 12)
WIRE_TUNING_INT(BlinkShockParticleCount, "wire.movement.blink_shock_particles", 30)
WIRE_TUNING_FLOAT(MoveTurnLerp, "wire.movement.turn_lerp", 0.22f)
WIRE_TUNING_FLOAT(ScaleRecoverLerp, "wire.movement.scale_recover_lerp", 0.08f)
WIRE_TUNING_FLOAT(GroundBobFrequency, "wire.movement.ground_bob_frequency", 4.0f)
WIRE_TUNING_FLOAT(GroundBobAmount, "wire.movement.ground_bob_amount", 0.015f)
WIRE_TUNING_FLOAT(JumpSquashXZ, "wire.movement.jump_squash_xz", 0.75f)
WIRE_TUNING_FLOAT(JumpStretchY, "wire.movement.jump_stretch_y", 1.35f)
WIRE_TUNING_FLOAT(PlayerFootMargin, "wire.movement.player_foot_margin", 0.45f)
WIRE_TUNING_FLOAT(PlatformLandingGrace, "wire.movement.platform_landing_grace", 0.15f)
WIRE_TUNING_GROUP_END()

// 壁蹴り。勢いを落とさず次の移動へ繋ぐことが目的で、単独の登坂手段にはしません。
WIRE_TUNING_GROUP(WireWallKickTuning, WallKick)
// 壁に触れてからこの時間内なら蹴れます。フレーム単位の精度を要求しないための猶予です。
WIRE_TUNING_FLOAT(ContactMemoryTime, "wire.wallkick.contact_memory_time", 0.22f)
WIRE_TUNING_FLOAT(Cooldown, "wire.wallkick.cooldown", 0.18f)
// 直前に蹴った壁との法線内積がこの値以上なら「同じ壁」とみなして拒否します。
WIRE_TUNING_FLOAT_RANGE(SameWallRejectDot, "wire.wallkick.same_wall_reject_dot", 0.75f, -1.0f, 1.0f)
WIRE_TUNING_FLOAT(NormalWeight, "wire.wallkick.normal_weight", 1.0f)
WIRE_TUNING_FLOAT(InputWeight, "wire.wallkick.input_weight", 1.25f)
// 入ってきた水平速度をどれだけ引き継ぐか。1に近いほど高速侵入が報われます。
WIRE_TUNING_FLOAT(SpeedCarryRatio, "wire.wallkick.speed_carry_ratio", 1.05f)
WIRE_TUNING_FLOAT(MinKickSpeed, "wire.wallkick.min_kick_speed", 17.0f)
WIRE_TUNING_FLOAT(MaxKickSpeed, "wire.wallkick.max_kick_speed", 46.0f)
WIRE_TUNING_FLOAT(UpSpeed, "wire.wallkick.up_speed", 11.5f)
WIRE_TUNING_FLOAT(SquashXZ, "wire.wallkick.squash_xz", 0.82f)
WIRE_TUNING_FLOAT(StretchY, "wire.wallkick.stretch_y", 1.24f)
WIRE_TUNING_INT(ParticleCount, "wire.wallkick.particle_count", 26)
WIRE_TUNING_GROUP_END()

// 止まらず動き続けることを報いるための連鎖状態です。
// ワイヤー・壁蹴り・空中ダッシュを続けるほど段階が上がります。
WIRE_TUNING_GROUP(WireMomentumTuning, Momentum)
// このアクション数ごとに段階が1つ上がります。
WIRE_TUNING_INT(ActionsPerRank, "wire.momentum.actions_per_rank", 3)
WIRE_TUNING_INT(MaxRank, "wire.momentum.max_rank", 4)
// 最後のアクションからこの時間何もしないと段階が落ちます。
WIRE_TUNING_FLOAT(DecayTime, "wire.momentum.decay_time", 3.2f)
// 段階ごとに増える移動速度と攻撃力の倍率です。
WIRE_TUNING_FLOAT(SpeedBonusPerRank, "wire.momentum.speed_bonus_per_rank", 0.09f)
WIRE_TUNING_FLOAT(DamageBonusPerRank, "wire.momentum.damage_bonus_per_rank", 0.16f)
// 地上で止まっている間は段階が早く落ちます。棒立ちを最適解にしないためです。
WIRE_TUNING_FLOAT(GroundedDecayScale, "wire.momentum.grounded_decay_scale", 2.4f)
WIRE_TUNING_GROUP_END()

WIRE_TUNING_GROUP(WireGrappleTuning, Grapple)
WIRE_TUNING_FLOAT(AimMaxTime, "wire.grapple.aim_max_time", 2.0f)
WIRE_TUNING_FLOAT(HookSpeed, "wire.grapple.hook_speed", 82.0f)
WIRE_TUNING_FLOAT(PullAcceleration, "wire.grapple.pull_acceleration", 8.0f)
WIRE_TUNING_FLOAT(MaxSpeed, "wire.grapple.max_speed", 42.0f)
WIRE_TUNING_FLOAT(ReleaseBoost, "wire.grapple.release_boost", 8.5f)
WIRE_TUNING_FLOAT(ReleaseUpBoost, "wire.grapple.release_up_boost", 8.0f)
WIRE_TUNING_FLOAT(ReleaseMaxSpeed, "wire.grapple.release_max_speed", 68.0f)
WIRE_TUNING_FLOAT(StopDistance, "wire.grapple.stop_distance", 1.6f) // 接続を切る距離ではなく、近距離で牽引を止める範囲
WIRE_TUNING_FLOAT(MaxDistance, "wire.grapple.max_distance", 60.0f)
WIRE_TUNING_FLOAT(AimConeDot, "wire.grapple.aim_cone_dot", 0.82f)
WIRE_TUNING_FLOAT(OriginHeight, "wire.grapple.origin_height", 1.0f)
WIRE_TUNING_FLOAT(AnchorMinDistance, "wire.grapple.anchor_min_distance", 0.1f)
WIRE_TUNING_FLOAT(AnchorDistancePenalty, "wire.grapple.anchor_distance_penalty", 0.012f)
WIRE_TUNING_FLOAT(AnchorRadiusBonus, "wire.grapple.anchor_radius_bonus", 0.05f)
WIRE_TUNING_FLOAT(NoAnchorCooldown, "wire.grapple.no_anchor_cooldown", 0.10f)
WIRE_TUNING_FLOAT(StartCooldown, "wire.grapple.start_cooldown", 0.04f)
WIRE_TUNING_FLOAT(LaunchImpulse, "wire.grapple.launch_impulse", 9.0f)
WIRE_TUNING_FLOAT(TurnLerp, "wire.grapple.turn_lerp", 0.30f)
WIRE_TUNING_FLOAT(ReleaseSquashXZ, "wire.grapple.release_squash_xz", 0.78f)
WIRE_TUNING_FLOAT(ReleaseStretchY, "wire.grapple.release_stretch_y", 1.28f)
WIRE_TUNING_FLOAT(AnchorAimScoreWeight, "wire.grapple.anchor_aim_score_weight", 2.0f)
// アーケード寄りの振り子制御。接続時は半径方向だけを整理し、接線速度を残します。
WIRE_TUNING_FLOAT(RopeLengthScale, "wire.grapple.rope_length_scale", 1.0f)
WIRE_TUNING_FLOAT(MinRopeLength, "wire.grapple.min_rope_length", 3.0f)
WIRE_TUNING_FLOAT(RadialDamping, "wire.grapple.radial_damping", 4.0f)
WIRE_TUNING_FLOAT(ConstraintStrength, "wire.grapple.constraint_strength", 34.0f)
WIRE_TUNING_FLOAT(SwingInputAcceleration, "wire.grapple.swing_input_acceleration", 38.0f)
WIRE_TUNING_FLOAT(AttachVelocityKeep, "wire.grapple.attach_velocity_keep", 0.98f)
WIRE_TUNING_FLOAT(AttachMinSpeed, "wire.grapple.attach_min_speed", 8.0f)
WIRE_TUNING_FLOAT(RewireBonus, "wire.grapple.rewire_bonus", 2.0f)
WIRE_TUNING_FLOAT(RewireBonusWindow, "wire.grapple.rewire_bonus_window", 1.15f)
WIRE_TUNING_FLOAT(RewireMaxSpeed, "wire.grapple.rewire_max_speed", 58.0f)
WIRE_TUNING_FLOAT(ReleasePoseDuration, "wire.grapple.release_pose_duration", 0.28f)
WIRE_TUNING_FLOAT(ReleasePoseRoll, "wire.grapple.release_pose_roll", 0.62f)
WIRE_TUNING_FLOAT(ReleasePoseTwist, "wire.grapple.release_pose_twist", 0.32f)
WIRE_TUNING_FLOAT(ReleaseLimbLag, "wire.grapple.release_limb_lag", 0.48f)
// 足場の角でワイヤーを折ります。0にすると従来どおり足場を貫通する直線です。
WIRE_TUNING_INT(WrapEnabled, "wire.grapple.wrap_enabled", 1)
// 1にすると伸びないロープとして扱い、たるんでいる間は引きません(実験用)。
// 0は牽引とバネで引き寄せる、操作感を優先した従来の挙動です。
WIRE_TUNING_INT(RigidRope, "wire.grapple.rigid_rope", 0)
// RigidRopeのとき、目標の長さまでワイヤーを巻き取る速さ(m/s)。
WIRE_TUNING_FLOAT(ReelSpeed, "wire.grapple.reel_speed", 30.0f)
WIRE_TUNING_GROUP_END()

