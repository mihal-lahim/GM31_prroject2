WIRE_TUNING_FLOAT(DetectHeightRange, "wire.enemy.detect_height_range", 6.0f) // 高さがこれ以上離れていれば見失う(別の踊り場の敵が反応しない)
WIRE_TUNING_FLOAT(AttackRadius, "wire.enemy.attack_radius", 2.2f)
WIRE_TUNING_FLOAT(AttackInterval, "wire.enemy.attack_interval", 1.2f)
WIRE_TUNING_INT(ContactDamage, "wire.enemy.contact_damage", 1)
WIRE_TUNING_FLOAT(KnockbackSpeed, "wire.enemy.knockback_speed", 13.0f)
WIRE_TUNING_FLOAT(KnockbackUpSpeed, "wire.enemy.knockback_up_speed", 5.5f)
